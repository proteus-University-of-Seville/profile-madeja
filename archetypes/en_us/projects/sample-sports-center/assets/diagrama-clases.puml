@startuml
skinparam defaultFontName Arial
hide empty methods
class Member {
  idNumber : String
  name : String
  email : String
  registrationDate : Date
}
abstract class Facility {
  name : String
  hourlyPrice : Decimal
}
class Court {
  sport : String
  covered : Boolean
}
class Room {
  capacity : Integer
}
class Booking {
  date : Date
  startTime : Time
  duration : Integer
  amount : Decimal
  status : BookingStatus
}
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  USED
}
Facility <|-- Court
Facility <|-- Room
Member "1 holder" -- "0..* bookings" Booking : holds >
Booking "0..* bookings" -- "1 facility" Facility : take_place_in >
Booking ..> BookingStatus
note bottom of Booking
  A member cannot have more than
  5 bookings in the same week [CON-001]
end note
@enduml
