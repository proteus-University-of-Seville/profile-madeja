@startuml
skinparam defaultFontName Arial
left to right direction
actor "Member\n[ACT-001]" as member
actor "Receptionist\n[ACT-002]" as receptionist
actor "Payment platform\n[ACT-003]" as payment
rectangle "Sports Center booking system" {
  usecase "Book facility\n[UC-001]" as uc1
  usecase "Cancel booking\n[UC-002]" as uc2
  usecase "Pay booking\n[UC-003]" as uc3
}
member --> uc1
member --> uc2
receptionist --> uc2
uc1 ..> uc3 : <<include>>
uc3 --> payment
@enduml
