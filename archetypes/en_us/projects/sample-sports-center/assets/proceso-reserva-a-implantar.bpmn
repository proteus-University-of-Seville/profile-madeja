      <bpmndi:BPMNEdge id="MF_ResultadoPago_di" bpmnElement="MF_ResultadoPago"><di:waypoint x="881" y="690" /><di:waypoint x="881" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="887" y="635" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_FalloPago_di" bpmnElement="MF_FalloPago"><di:waypoint x="1030" y="370" /><di:waypoint x="1030" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="860" y="112" width="164" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Justificante_di" bpmnElement="MF_Justificante"><di:waypoint x="1103" y="250" /><di:waypoint x="1103" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="1109" y="112" width="150" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
