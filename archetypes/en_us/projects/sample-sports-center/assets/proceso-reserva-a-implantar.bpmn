      <bpmndi:BPMNEdge id="MF_Disponibilidad_di" bpmnElement="MF_Disponibilidad"><di:waypoint x="359" y="250" /><di:waypoint x="359" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="365" y="112" width="80" height="54" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Solicitud_di" bpmnElement="MF_Solicitud"><di:waypoint x="450" y="100" /><di:waypoint x="450" y="272" />
        <bpmndi:BPMNLabel><dc:Bounds x="456" y="112" width="160" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Rechazo_di" bpmnElement="MF_Rechazo"><di:waypoint x="705" y="370" /><di:waypoint x="705" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="711" y="112" width="140" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Cobro_di" bpmnElement="MF_Cobro"><di:waypoint x="795" y="330" /><di:waypoint x="795" y="690" />
