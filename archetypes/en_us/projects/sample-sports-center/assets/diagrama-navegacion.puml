@startuml
skinparam defaultFontName Arial
title Navigation of the members portal
state "Access with Cl@ve" as access
state "Home" as home
state "Facility availability" as availability
state "Confirmation and payment" as confirmation
state "My bookings" as mybookings
[*] --> access
access --> home
home --> availability : Book
home --> mybookings : My bookings
availability --> confirmation : choose time slot
confirmation --> mybookings : payment accepted
mybookings --> home : Back
mybookings --> mybookings : Cancel booking
@enduml
