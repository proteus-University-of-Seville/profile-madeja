@startuml
skinparam defaultFontName Arial
package "Presentation layer" {
  [Members web portal] as portal
  [Reception application] as reception
}
package "Business logic layer" {
  [Booking service] as bookings
  [Member service] as members
  [Report service] as reports
}
package "Persistence layer" {
  [Data repository] as repo
  database "PostgreSQL" as db
}
cloud "External services" {
  [Cl@ve] as clave
  [Municipal payment platform] as payment
}
portal --> bookings
portal --> members
reception --> bookings
reception --> reports
bookings --> repo
members --> repo
reports --> repo
repo --> db
members ..> clave
bookings ..> payment
@enduml
