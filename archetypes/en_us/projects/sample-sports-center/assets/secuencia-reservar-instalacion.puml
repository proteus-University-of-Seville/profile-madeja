@startuml
skinparam defaultFontName Arial
title Book facility [UC-001]
actor Member
participant "Web portal" as portal
participant "Booking service" as bookings
participant "Payment platform" as payment
database "Repository" as repo
Member -> portal : chooses facility and time slot
portal -> bookings : checkAvailability(facility, date)
bookings -> repo : find the bookings of the date
repo --> bookings : bookings
bookings --> portal : free time slots
Member -> portal : confirms the time slot
portal -> bookings : createBooking(member, facility, date, time, duration)
bookings -> bookings : check rule BRU-001
bookings -> repo : save booking (PENDING_PAYMENT)
bookings -> payment : charge(amount, reference)
payment --> bookings : payment accepted
bookings -> repo : update status (CONFIRMED)
bookings --> portal : booking confirmed
portal --> Member : booking receipt
@enduml
