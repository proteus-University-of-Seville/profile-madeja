@startuml
skinparam defaultFontName Arial
title Life cycle of a booking
[*] --> PendingPayment : createBooking
PendingPayment --> Confirmed : payment accepted
PendingPayment --> Cancelled : payment rejected or\npayment deadline expired
Confirmed --> Cancelled : cancelBooking
Confirmed --> Used : end of the time slot
Cancelled --> [*]
Used --> [*]
@enduml
