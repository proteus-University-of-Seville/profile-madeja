@startuml
skinparam defaultFontName Arial
component "Booking service" as bookings
interface "IBookings" as ibookings
bookings -up- ibookings
note right of ibookings
  checkAvailability(facility, date)
  createBooking(member, facility, date, time, duration)
  cancelBooking(booking)
end note
component "Municipal payment platform" as payment
interface "IPayment" as ipayment
payment -up- ipayment
bookings ..> ipayment : uses
component "Cl@ve" as clave
interface "IAuthentication" as iauth
clave -up- iauth
component "Member service" as members
members ..> iauth : uses
@enduml
